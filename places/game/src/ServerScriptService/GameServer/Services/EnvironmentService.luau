--!nonstrict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Config=require(game.ReplicatedStorage.Game.Shared.Config.PlaceConfig)
local Scope=require(game.ReplicatedStorage.Game.Shared.Utilities.CleanupScope)
local Service={};Service.__index=Service
function Service.new()return setmetatable({Name="EnvironmentService",Dependencies={}},Service)end
function Service:Init()
	self._scope=Scope.new()
	self.Role=Config.Resolve(game.PlaceId,RunService:IsStudio(),workspace:GetAttribute("EHStudioPlaceRole"))
	game.ReplicatedStorage.Game:SetAttribute("PlaceRole",self.Role)
	-- Every floor is authored geometry, visible and editable in Workspace.BlackwaterAuthoring
	-- between play sessions (Level5 in place; Level4..Level1 off to the side by their
	-- AuthoringOffset). Park each one, in its in-game position, as the template FloorRegistry
	-- clones; nothing is generated by script.
	if self.Role=="Game" then
		local authoring=workspace:FindFirstChild("BlackwaterAuthoring")
		local templates=game.ServerStorage.GameAssets.FloorTemplates
		for _,source in authoring and authoring:GetChildren() or {} do
			if source:IsA("Model") and source.Name:match("^Level%d+$") then
				local old=templates:FindFirstChild(source.Name)
				if old and old~=source then old.Name="Superseded"..source.Name;old.Parent=game.ServerStorage end
				local offset=source:GetAttribute("AuthoringOffset") or Vector3.zero
				if offset~=Vector3.zero then source:PivotTo(source:GetPivot()-offset) end
				source.Parent=templates
				-- (R27) one frame between floors: parking a whole floor is heavy, and doing every floor in
				-- one go could run past the script time limit and stop the server from starting
				task.wait()
				self._scope:Add(function()
					if source.Parent and authoring.Parent then
						if offset~=Vector3.zero then source:PivotTo(source:GetPivot()+offset) end
						source.Parent=authoring
					end
				end)
			end
		end
	end
	-- ShaftLink is the stretch of lift shaft between Level 5 and Level 4 (authored straight below
	-- it), only there so the stack reads in Studio. Parked for the run, put back when it stops.
	if self.Role=="Game" then
		local authoring=workspace:FindFirstChild("BlackwaterAuthoring")
		local link=authoring and authoring:FindFirstChild("ShaftLink")
		if link then link.Parent=game.ServerStorage;self._scope:Add(function()if link.Parent and authoring.Parent then link.Parent=authoring end end) end
	end
	-- The surface yard is authored in Workspace.BlackwaterAuthoring.SurfaceYard, raised by its
	-- AuthoringOffset so it never overlaps Level 5 while editing. Lower it into place and park it as
	-- the boarding template (ElevatorService places a copy around the lift for each run).
	if self.Role=="Game" then
		local authoring=workspace:FindFirstChild("BlackwaterAuthoring")
		local yard=authoring and authoring:FindFirstChild("SurfaceYard")
		if yard then
			local offset=yard:GetAttribute("AuthoringOffset") or Vector3.zero
			local assets=game.ServerStorage.GameAssets;local old=assets:FindFirstChild("SurfaceYard")
			if old and old~=yard then old.Name="SupersededSurfaceYard";old.Parent=game.ServerStorage end
			yard:PivotTo(yard:GetPivot()-offset);yard.Parent=assets
			task.wait()
			self._scope:Add(function()if yard.Parent and authoring.Parent then yard:PivotTo(yard:GetPivot()+offset);yard.Parent=authoring end end)
		end
	end
	local runtime=workspace:FindFirstChild("Runtime")
	if not runtime then runtime=Instance.new("Folder");runtime.Name="Runtime";runtime.Parent=workspace end
	local name=self.Role=="Lobby" and "LobbyEnvironment" or "DescentEnvironment"
	local other=runtime:FindFirstChild(self.Role=="Lobby" and "DescentEnvironment" or "LobbyEnvironment")
	if other then
		-- A Studio role preview may temporarily park the other authored scene, never delete it.
		other.Parent=game.ServerStorage
		self._scope:Add(function()if other.Parent then other.Parent=runtime end end)
	end
	-- The environment is authored in Workspace.Runtime; it is never generated by script.
	self.Model=runtime:FindFirstChild(name)
	assert(self.Model and self.Model:IsA("Model"),"Missing authored Workspace.Runtime."..name)
	-- The lift is authored in Workspace.BlackwaterAuthoring.Elevator; the run uses that exact model
	-- inside DescentEnvironment and hands it back when the server stops (never rebuilt at runtime).
	if self.Role=="Game" then
		local authoring=workspace:FindFirstChild("BlackwaterAuthoring")
		local lift=authoring and authoring:FindFirstChild("Elevator")
		if lift then
			local previous=self.Model:FindFirstChild("Elevator")
			if previous and previous~=lift then previous.Parent=game.ServerStorage;self._scope:Add(function()if previous.Parent then previous.Parent=self.Model end end)end
			lift.Parent=self.Model
			self._scope:Add(function()if lift.Parent and authoring.Parent then lift.Parent=authoring end end)
		end
	end
	self.Model.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
	self.Spawn=assert(self.Model:FindFirstChild(self.Role=="Lobby" and "LobbySpawn" or "GameSpawn"),"Missing environment spawn")
	assert(self.Spawn:IsA("SpawnLocation"),"Invalid spawn")
	self.Spawn.Enabled=true
	for _,s in workspace:GetDescendants()do if s:IsA("SpawnLocation") and s~=self.Spawn then s.Enabled=false end end
	local function setup(p)
		p.RespawnLocation=self.Spawn
		p.CameraMode=self.Role=="Lobby" and Enum.CameraMode.Classic or Enum.CameraMode.LockFirstPerson
		p.CameraMaxZoomDistance=self.Role=="Lobby" and 16 or .5;p.CameraMinZoomDistance=self.Role=="Lobby" and 8 or .5
	end
	self._scope:Add(Players.PlayerAdded:Connect(setup));for _,p in Players:GetPlayers()do setup(p)end
end
function Service:Start()end
function Service:Destroy()if self._scope then self._scope:Destroy()end end
return table.freeze(Service)