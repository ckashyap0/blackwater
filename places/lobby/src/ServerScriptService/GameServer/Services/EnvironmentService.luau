--!nonstrict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Config=require(game.ReplicatedStorage.Game.Shared.Config.PlaceConfig)
local Scope=require(game.ReplicatedStorage.Game.Shared.Utilities.CleanupScope)
local Service={};Service.__index=Service
function Service.new()return setmetatable({Name="EnvironmentService",Dependencies={}},Service)end
function Service:Init()
	self._scope=Scope.new()
	self.Role=Config.Resolve(game.PlaceId,RunService:IsStudio(),workspace:GetAttribute("EHStudioPlaceRole"))
	game.ReplicatedStorage.Game:SetAttribute("PlaceRole",self.Role)
	local runtime=workspace:FindFirstChild("Runtime")
	if not runtime then runtime=Instance.new("Folder");runtime.Name="Runtime";runtime.Parent=workspace end
	local name=self.Role=="Lobby" and "LobbyEnvironment" or "DescentEnvironment"
	local other=runtime:FindFirstChild(self.Role=="Lobby" and "DescentEnvironment" or "LobbyEnvironment")
	if other then
		-- A Studio role preview may temporarily park the other authored scene, never delete it.
		other.Parent=game.ServerStorage
		self._scope:Add(function()if other.Parent then other.Parent=runtime end end)
	end
	-- The environment is authored in Workspace.Runtime; it is never generated by script.
	self.Model=runtime:FindFirstChild(name)
	assert(self.Model and self.Model:IsA("Model"),"Missing authored Workspace.Runtime."..name)
	self.Model.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
	self.Spawn=assert(self.Model:FindFirstChild(self.Role=="Lobby" and "LobbySpawn" or "GameSpawn"),"Missing environment spawn")
	assert(self.Spawn:IsA("SpawnLocation"),"Invalid spawn")
	self.Spawn.Enabled=true
	for _,s in workspace:GetDescendants()do if s:IsA("SpawnLocation") and s~=self.Spawn then s.Enabled=false end end
	local function setup(p)
		p.RespawnLocation=self.Spawn
		p.CameraMode=self.Role=="Lobby" and Enum.CameraMode.Classic or Enum.CameraMode.LockFirstPerson
		p.CameraMaxZoomDistance=self.Role=="Lobby" and 16 or .5;p.CameraMinZoomDistance=.5 -- lobby: free to zoom all the way into first person
	end
	self._scope:Add(Players.PlayerAdded:Connect(setup));for _,p in Players:GetPlayers()do setup(p)end
end
function Service:Start()end
function Service:Destroy()if self._scope then self._scope:Destroy()end end
return table.freeze(Service)
